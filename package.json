{
  "name": "@optiklab/web-gpu-visualizer-component",
  "version": "0.1.3",
  "description": "WebGPU-first 3D OBJ visualizer with a Canvas CPU fallback and React bindings.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optiklab/web-gpu-visualizer-component.git"
  },
  "homepage": "https://github.com/optiklab/web-gpu-visualizer-component#readme",
  "bugs": "https://github.com/optiklab/web-gpu-visualizer-component/issues",
  "keywords": [
    "react",
    "webgpu",
    "canvas",
    "3d",
    "obj",
    "visualizer"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run lint && npm test && npm run build && npm run test:package",
    "pack:check": "npm pack --dry-run",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@webgpu/types": "^0.1.69",
    "eslint": "^9.39.0",
    "happy-dom": "^20.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
